

import math
import random

def drawCircle(t, x, y, radius=150):
    """
    Draws a circle in a turtle window by creating 120 sectors.
    Each sector goes out by the radius, shifts along the arc by 3 degrees,
    and returns to the center to fill with a random color.
    """
    # Calculate the exact distance moved on the outer arc for a 3-degree slice
    # Formula: (2.0 * pi * radius) / 120.0
    distance = (2.0 * math.pi * radius) / 120.0
    
    total_distance = 0.0

    try:
        t.screen.colormode(255)
    except Exception:
        pass

    # Position the turtle at the center point
    t.up()
    t.goto(x, y)
    t.setheading(0)
    
    # 120 sectors * 3 degrees = 360 degrees total
    for i in range(120):
        # Pick a random color for this slice
        r = random.randint(0, 255)
        g = random.randint(0, 255)
        b = random.randint(0, 255)
        
        t.fillcolor(r, g, b)
        t.begin_fill()
        t.down()
        
        # 1. Draw a line out to the edge (150 pixels)
        t.forward(radius)
        total_distance += radius
        
        # 2. Turn perpendicular to the radius line and move along the 3-degree arc step
        t.left(90)
        t.forward(distance)
        total_distance += distance
        
        # 3. Turn slightly past 90 degrees to head directly back to the center
        t.left(90 + 3)
        t.forward(radius)
        total_distance += radius
        
        # Complete and color this slice
        t.end_fill()
        t.up()
        
        # 4. Reset to center and pivot absolute heading for the next space
        t.goto(x, y)
        t.setheading((i + 1) * 3)
        
    print(f"Total Distance Moved: {total_distance:.2f} pixels")
    return total_distance
